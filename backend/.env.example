"""Environment variables template for HospRecruit AI backend."""

# FastAPI
DEBUG=True
API_VERSION=v1

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# SMS (Twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ATS Integration (Merge.dev)
MERGE_DEV_API_KEY=...
MERGE_DEV_BASE_URL=https://api.merge.dev/api

# Payment (Stripe) — DISABLED BY DEFAULT
# Stripe is the original US billing rail. Indian billing settles through
# Razorpay, so this stays off unless you genuinely have a Stripe account.
# While BILLING_ENABLED=false the /api/v1/billing routes are not mounted and
# the three keys below may be left blank.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis/Celery (optional, for background jobs)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
APP_BASE_URL=http://localhost:5173
API_PUBLIC_BASE_URL=http://localhost:8000

# India-resident encrypted document storage
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_KMS_KEY_ID=  # optional; when omitted, S3-managed AES256 encryption is used

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Hotel PMS (IDS Next / eZee / Hotelogix) — occupancy-driven staffing
# Keys are NOT stored in the database. Each property's PMS connection records
# the NAME of the env var holding its key (credential_env_var); set that var
# here. One per property, e.g.:
# PMS_API_KEY_GOA01=
# PMS_API_KEY_DELHI02=
# The MOCK provider is a fully offline sandbox and needs no key.
